{
  "name": "if-it-were-you",
  "version": "0.3.1",
  "private": true,
  "description": "假如是你 —— 输入小说名，生成设定圣经，再走进故事的文字冒险。",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/",
    "lint:build": "eslint . --quiet",
    "lint:style": "stylelint \"src/**/*.css\"",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm ts-check && pnpm lint:build && pnpm lint:style"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  }
}
